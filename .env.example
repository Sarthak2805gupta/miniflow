# Copy this file to .env and edit.

# Free key from https://console.groq.com/keys
# With a key: fast cloud transcription + AI cleanup.
# Without a key: local offline Whisper, no cleanup.
GROQ_API_KEY=

# groq or local (defaults to groq if a key is set, otherwise local)
# ENGINE=groq

# Key to hold while talking: alt_r (Right Option), cmd_r, ctrl_r, f13 ...
HOTKEY=alt_r

# Key to hold to EDIT selected text with your voice (empty = off)
EDIT_HOTKEY=cmd_r

# Language code, or leave empty to auto-detect (e.g. for Hindi + English mix)
LANGUAGE=en

# AI cleanup of filler words / punctuation: on or off
CLEANUP=on

# Local model: tiny.en, base.en, small.en, medium.en (bigger = better but slower)
LOCAL_MODEL=base.en

# Groq models (change only if Groq renames them)
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Floating box that shows your words live while you speak: on or off
LIVE_PREVIEW=on
# Model for the live box: tiny.en (fastest) or base.en (a bit better)
PREVIEW_MODEL=tiny.en

# Prompt mode: turns what you say into a well-structured prompt for AI tools.
# off | on | auto (only in the apps listed in AI_APPS)
PROMPT_MODE=auto
AI_APPS=ChatGPT,Claude,Cursor,Perplexity,Gemini,Copilot,Windsurf
